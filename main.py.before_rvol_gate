            "signal_stop": signal.stop_loss,
            "signal_target": signal.target,
            "signal_timestamp": signal.timestamp,
            "signal_candle_start": pre_order_timing[
                "signal_candle_start"
            ],
            "signal_candle_close": pre_order_timing[
                "signal_candle_close"
            ],
            "scan_started_at": pre_order_timing[
                "scan_started_at"
            ],
