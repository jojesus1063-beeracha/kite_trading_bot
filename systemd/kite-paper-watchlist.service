[Unit]
Description=Build frozen full-universe top-60 PAPER watchlist and start the paper bot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/kitebot.env
WorkingDirectory=/home/ubuntu/kite_trading_bot
# Fail closed: stop the existing PAPER process before selection and start the
# updated PAPER stack only after selector validation succeeds.
ExecStartPre=+/usr/bin/systemctl stop kitebot-paper-contrarian.service
ExecStart=/bin/bash /home/ubuntu/kite_trading_bot/run_paper_watchlist_daily.sh
ExecStartPost=+/usr/bin/systemctl start kitebot-paper-contrarian.service
TimeoutStartSec=900
UMask=0027
StandardOutput=journal
StandardError=journal
