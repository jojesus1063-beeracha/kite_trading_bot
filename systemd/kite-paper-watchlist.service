[Unit]
Description=Build cleaned full-Zerodha top-60 PAPER watchlist and start CP9 PAPER bot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/kitebot.env
WorkingDirectory=/home/ubuntu/kite_trading_bot
# Fail closed: stop the currently-running PAPER bot before rebuilding the
# morning universe, then start the already-installed PAPER bot unit only after
# the selector and all validation checks complete successfully.
ExecStartPre=+/usr/bin/systemctl stop kitebot-paper-contrarian.service
ExecStart=/bin/bash /home/ubuntu/kite_trading_bot/run_paper_watchlist_daily.sh
ExecStartPost=+/usr/bin/systemctl start kitebot-paper-contrarian.service
TimeoutStartSec=900
UMask=0027
StandardOutput=journal
StandardError=journal
