[Unit]
Description=Matmon HaElohim - Fresh Pre-open Top-120
Wants=network-online.target
After=network-online.target
Before=kitebot-matmon-paper.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/kitebot.env
WorkingDirectory=/home/ubuntu/kite_trading_bot
ExecStart=/home/ubuntu/kite_trading_bot/matmon_preopen_auto.sh
TimeoutStartSec=720
UMask=0027
StandardOutput=journal
StandardError=journal
