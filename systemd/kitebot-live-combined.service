[Unit]
Description=Kite Trading Bot - guarded combined LIVE mode
Wants=network-online.target
After=network-online.target
Conflicts=kitebot-paper-contrarian.service kitebot.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/kitebot.env
WorkingDirectory=/home/ubuntu/kite_trading_bot
ExecStart=/home/ubuntu/kite_trading_bot/venv/bin/python3 /home/ubuntu/kite_trading_bot/combined_live_launcher.py
Restart=no
UMask=0027
StandardOutput=journal
StandardError=journal
