[Unit]
Description=MATMON_HAELOHIM single-strategy live bot
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kite_trading_bot
Environment=TZ=Asia/Kolkata
EnvironmentFile=/home/ubuntu/kite_trading_bot/.env
EnvironmentFile=-/home/ubuntu/kite_trading_bot/matmon-live.env
ExecStartPre=/home/ubuntu/kite_trading_bot/venv/bin/python3 /home/ubuntu/kite_trading_bot/matmon_live_preflight.py --check-broker-flat
ExecStart=/home/ubuntu/kite_trading_bot/venv/bin/python3 /home/ubuntu/kite_trading_bot/matmon_live_launcher.py
Restart=no
[Install]
WantedBy=multi-user.target
